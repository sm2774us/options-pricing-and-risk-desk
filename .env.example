# All variables are optional; defaults shown.
OPTDESK_BUS_URL=memory://        # redis://redis:6379/0 for distributed mode
OPTDESK_TICK_HZ=30               # ticks per second per symbol
OPTDESK_TIME_SCALE=25            # simulated seconds per real second
OPTDESK_FRAME_HZ_CAP=60          # max surface frames/s/symbol
OPTDESK_N_STRIKES=61
OPTDESK_EXPIRY_DAYS=1,2,3,5,7,14,21,30,45,60,90,120,180,270,365
OPTDESK_PRICER_SYMBOLS=          # shard filter, e.g. SPY,QQQ
OPTDESK_ACK_WINDOW=4
OPTDESK_SEED=                    # set for a deterministic feed
OPTDESK_LOG_LEVEL=INFO
